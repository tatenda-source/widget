# ============================================================
# Falcon Giving Broker — environment template
# Copy this to .env (do not commit .env)
# ============================================================

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:4173

# ------------------------------------------------------------
# BillPay Vendor API
# ------------------------------------------------------------
# Set BILLPAY_MODE=mock for demos without real credentials.
# The mock backend short-circuits BillPay calls with realistic
# responses (and persists state in-memory) so the widget can
# exercise the full flow without a live BillPay account.
#
# Set BILLPAY_MODE=live to actually hit BillPay. Requires real
# vendor credentials provisioned by Paynow support.
BILLPAY_MODE=mock
BILLPAY_BASE_URL=https://billpay.paynow.co.zw
BILLPAY_USER=replace-me
BILLPAY_PASS=replace-me

# The Falcon biller code on BillPay. Once Falcon is provisioned
# as a real biller, this is what the broker filters TargetStats,
# Feed, and ListBillers against.
BILLER_CODE=FAL
DEFAULT_CURRENCY=USD

# ------------------------------------------------------------
# Paynow merchant API (the donor-facing rails — Ecocash, Visa, etc.)
# This is the existing merchant API, distinct from BillPay.
# The broker uses these to debit the donor's chosen payment
# method; once those funds land in our vendor wallet, BillPay
# routes them to the Falcon biller.
# ------------------------------------------------------------
PAYNOW_INTEGRATION_ID=replace-me
PAYNOW_INTEGRATION_KEY=replace-me
PAYNOW_RESULT_URL=http://localhost:4000/api/webhooks/paynow-merchant
PAYNOW_RETURN_URL=http://localhost:4173/?status=return

# ------------------------------------------------------------
# Webhook security
# Bearer token that BillPay should present when calling our
# biller-config webhook. Per the BillPay spec, this is
# recommended but not required.
# ------------------------------------------------------------
BILLPAY_WEBHOOK_BEARER=replace-with-a-long-random-string
